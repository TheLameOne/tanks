{
  "name": "tanks-website",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build && node scripts/github-pages-spa.mjs",
    "build:pages": "tsc -b && vite build --base=/tanks/ && node scripts/github-pages-spa.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "predeploy": "npm run build:pages",
    "deploy": "gh-pages -d dist"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@react-three/drei": "^9.122.0",
    "@react-three/fiber": "^8.18.0",
    "@types/three": "^0.169.0",
    "framer-motion": "^11.11.11",
    "gsap": "^3.15.0",
    "locomotive-scroll": "^5.0.1",
    "lucide-react": "^0.453.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.170.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "gh-pages": "^6.1.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  }
}
